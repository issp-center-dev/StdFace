# Small public-format Wannier inputs shared by generator regression tests.
cmake_minimum_required(VERSION 3.0...3.10)

function(write_wannier path n coordinates values)
    list(LENGTH coordinates nr)
    list(LENGTH values nv)
    math(EXPR expected "${nr} * ${n} * ${n}")
    if(NOT nv EQUAL expected)
        message(FATAL_ERROR "Invalid test fixture ${path}: ${nv} != ${expected}")
    endif()
    set(text "Wannier regression fixture\n${n}\n${nr}\n")
    foreach(r ${coordinates})
        set(text "${text}1 ")
    endforeach()
    set(text "${text}\n")
    set(k 0)
    foreach(r ${coordinates})
        foreach(i RANGE 1 ${n})
            foreach(j RANGE 1 ${n})
                list(GET values ${k} value)
                set(text "${text}${r} ${i} ${j} ${value}\n")
                math(EXPR k "${k} + 1")
            endforeach()
        endforeach()
    endforeach()
    file(WRITE "${path}" "${text}")
endfunction()

function(wannier_input dir n model extra)
    file(REMOVE_RECURSE "${dir}")
    file(MAKE_DIRECTORY "${dir}")
    set(geom "1 0 0\n0 1 0\n0 0 1\n${n}\n")
    foreach(i RANGE 1 ${n})
        set(geom "${geom}0 0 0\n")
    endforeach()
    file(WRITE "${dir}/zvo_geom.dat" "${geom}")
    set(input "lattice = \"wannier90\"\nmodel = \"${model}GC\"\nW = 3\nL = 1\nHeight = 1\n")
    if(MODE STREQUAL "hphi")
        set(input "${input}method = \"CG\"\n")
    elseif(NOT model STREQUAL "Spin")
        set(input "${input}ncond = 2\n")
    endif()
    if(MODE STREQUAL "hwave")
        set(input "${input}calcmode = \"uhfr\"\n")
    endif()
    file(WRITE "${dir}/stan.in" "${input}${extra}")
endfunction()

function(run_wannier dir reject diagnostic)
    # Poison newly allocated memory on glibc, macOS, and ASan respectively.
    # Preserve caller sanitizer options (including leak-check policy).
    execute_process(COMMAND "${CMAKE_COMMAND}" -E env
        "MALLOC_PERTURB_=191" "MallocScribble=1"
        "ASAN_OPTIONS=$ENV{ASAN_OPTIONS}:malloc_fill_byte=64"
        "${PROGRAM}" stan.in WORKING_DIRECTORY "${dir}"
        RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE error TIMEOUT 20)
    set(log "${output}${error}")
    file(WRITE "${dir}/run.log" "${log}")
    if(log MATCHES "AddressSanitizer|UndefinedBehaviorSanitizer|runtime error:")
        message(FATAL_ERROR "Sanitizer error in ${dir}/run.log")
    endif()
    if(reject)
        if(NOT "${result}" STREQUAL "255" OR NOT log MATCHES "${diagnostic}")
            message(FATAL_ERROR "Expected input error 255 (${diagnostic}), got ${result}; see ${dir}/run.log")
        endif()
    elseif(NOT "${result}" STREQUAL "0")
        message(FATAL_ERROR "Valid input failed (${result}); see ${dir}/run.log")
    endif()
endfunction()
