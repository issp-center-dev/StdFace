# Exercise the public input parser and generated Hamiltonians, without running
# a solver. Each invalid input must fail with its own unused-parameter message.
cmake_minimum_required(VERSION 3.0...3.10)
set(case_count 0)

function(run_input lattice model key value reject signature)
    math(EXPR case_count "${case_count} + 1")
    set(case_count ${case_count} PARENT_SCOPE)
    set(dir "${WORK}/${case_count}")
    file(REMOVE_RECURSE "${dir}")
    file(MAKE_DIRECTORY "${dir}")
    set(input "lattice = \"${lattice}\"\nmodel = \"${model}GC\"\nL = 2\nW = 1\nHeight = 1\n")
    if(MODE STREQUAL "hphi")
        set(input "${input}method = \"CG\"\n")
    elseif(NOT model STREQUAL "Spin")
        set(input "${input}ncond = 2\n")
    endif()
    if(MODE STREQUAL "hwave")
        # Real-space output avoids the unrelated Kondo Wannier export path.
        set(input "${input}calcmode = \"uhfr\"\n")
    endif()
    if(model STREQUAL "Spin")
        if(lattice STREQUAL "pyrochlore" AND key MATCHES "^J[012]'$")
            # The scalar fallback and a directional override are mutually exclusive.
            set(input "${input}h = 0.125\n")
        else()
            set(input "${input}J = 1\n")
        endif()
    else()
        if(lattice STREQUAL "pyrochlore" AND key MATCHES "^t[012]'$")
            set(input "${input}mu = 0.125\n")
        else()
            set(input "${input}t = 1\n")
        endif()
        if(model STREQUAL "Kondo")
            set(input "${input}J = 1\n")
        endif()
    endif()
    if(NOT key STREQUAL "")
        set(input "${input}${key} = ${value}\n")
    endif()
    file(WRITE "${dir}/stan.in" "${input}")
    execute_process(COMMAND "${PROGRAM}" stan.in WORKING_DIRECTORY "${dir}"
        RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE error TIMEOUT 20)
    file(WRITE "${dir}/run.log" "${output}${error}")
    if(reject)
        string(FIND "${output}${error}" "${key} is SPECIFIED but will NOT be USED" found)
        # Reject signals/timeouts and unrelated validation errors as well as success.
        if(NOT "${result}" STREQUAL "255" OR found EQUAL -1)
            message(FATAL_ERROR "${MODE}/${lattice}/${model}: ${key}=${value}: expected unused-input exit 255, got ${result}; see ${dir}/run.log")
        endif()
    else()
        if(NOT "${result}" STREQUAL "0")
            message(FATAL_ERROR "Valid ${MODE}/${lattice}/${model}: ${key}=${value} failed (${result}); see ${dir}/run.log")
        endif()
        set(digest "")
        foreach(name trans interall coulombintra coulombinter hund exchange pairhop pairlift)
            if(EXISTS "${dir}/${name}.def")
                file(SHA256 "${dir}/${name}.def" hash)
                set(digest "${digest}${name}:${hash};")
            endif()
        endforeach()
        if(digest STREQUAL "")
            message(FATAL_ERROR "No Hamiltonian output in ${dir}")
        endif()
        set(${signature} "${digest}" PARENT_SCOPE)
    endif()
endfunction()

foreach(lattice orthorhombic pyrochlore fcc)
    foreach(model Spin Hubbard Kondo)
        # Unspecified inputs remain valid in each generator/model combination.
        run_input(${lattice} ${model} "" "" FALSE unused)
        set(keys "t0''" "t1''" "t2''" "V0''" "V1''" "V2''")
        set(jkeys "J0''" "J1''" "J2''")
        if(lattice STREQUAL "pyrochlore")
            list(APPEND keys "t'" "t''" "V'" "V''")
            list(APPEND jkeys "J'" "J''")
        elseif(lattice STREQUAL "fcc")
            # No double-prime bonds at all; J' only feeds the spin model.
            list(APPEND keys "t''" "V''")
            list(APPEND jkeys "J''")
            if(NOT model STREQUAL "Spin")
                list(APPEND jkeys "J'")
            endif()
        elseif(NOT model STREQUAL "Spin")
            list(APPEND jkeys "J'" "J''")
        endif()
        if(model STREQUAL "Spin")
            list(APPEND keys V2 "V0'" "V1'" "V2'")
            if(lattice STREQUAL "orthorhombic")
                list(APPEND keys "V''")
            endif()
        endif()
        foreach(jkey ${jkeys})
            list(APPEND keys "${jkey}")
            foreach(component x y z xy xz yx yz zx zy)
                list(APPEND keys "${jkey}${component}")
            endforeach()
        endforeach()
        foreach(key ${keys})
            run_input(${lattice} ${model} "${key}" 0.375 TRUE unused)
        endforeach()
        # Explicit zero and negative values are specified, not defaults.
        foreach(value 0 -0.375)
            foreach(key "t0''" "V0''" "J0''xy")
                run_input(${lattice} ${model} "${key}" ${value} TRUE unused)
            endforeach()
        endforeach()
        run_input(${lattice} ${model} "t1''" "0,0.375" TRUE unused)

        # Directional prime parameters are active on every lattice. Scalar
        # prime parameters are additionally active on Orthorhombic and fcc,
        # scalar double-prime parameters on Orthorhombic only.
        if(model STREQUAL "Spin")
            set(active "J0'" "J1'" "J2'")
            if(lattice STREQUAL "orthorhombic")
                list(APPEND active "J'" "J''")
            elseif(lattice STREQUAL "fcc")
                list(APPEND active "J'")
            endif()
        else()
            set(active "t0'" "t1'" "t2'" "V0'" "V1'" "V2'")
            if(lattice STREQUAL "orthorhombic")
                list(APPEND active "t'" "t''" "V'" "V''")
            elseif(lattice STREQUAL "fcc")
                list(APPEND active "t'" "V'")
            endif()
        endif()
        foreach(key ${active})
            run_input(${lattice} ${model} "${key}" 0 FALSE zero)
            run_input(${lattice} ${model} "${key}" 0.375 FALSE nonzero)
            if(zero STREQUAL nonzero)
                message(FATAL_ERROR "${MODE}/${lattice}/${model}: active ${key} did not change the Hamiltonian")
            endif()
        endforeach()
    endforeach()
endforeach()
message(STATUS "Unused 3D parameters (${MODE}): ${case_count} input cases passed")
